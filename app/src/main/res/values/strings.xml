    <string name="onboarding_desc_2">No phone number. No email. No servers. Your identity is a local cryptographic key stored securely on your device.</string>
    <string name="onboarding_title_3">End-to-End Encrypted</string>
    <string name="onboarding_desc_3">Private 1-on-1 and group chats use modern forward-secret encryption. Only intended recipients can decrypt them.</string>
